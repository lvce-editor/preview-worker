{
  "name": "@lvce-editor/preview-worker-monorepo",
  "version": "0.0.0-dev",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.js",
    "build:static": "node packages/build/src/build-static.ts",
    "build:watch": "node packages/build/src/build-watch.ts",
    "dev": "node packages/build/src/dev.js",
    "e2e": "cd packages/e2e && npm run e2e",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check . && knip --no-config-hints",
    "measure": "cd packages/memory && npm run measure",
    "test": "npm test --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 150
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^17.6.0",
    "@lvce-editor/eslint-plugin-github-actions": "^17.7.0",
    "@lvce-editor/eslint-plugin-tsconfig": "^17.7.0",
    "eslint": "^10.8.0",
    "knip": "^6.29.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
